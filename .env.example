# ==============================================================================
# AI Loan Approval System - Environment Variables Template
# ==============================================================================
# Copy this file to .env or use config.json for system settings.
# Do NOT store real secrets or sensitive credentials in version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (Optional - falls back to local supervisor if blank)
# ------------------------------------------------------------------------------
# Get your free API key securely from https://aistudio.google.com/
# NEVER commit your actual .env file or API key to version control.
GEMINI_API_KEY=""
# Recommended high-quota supported model: gemini-3.5-flash-lite
LLM_MODEL="gemini-3.5-flash-lite"
LLM_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 2. Firebase Realtime Database (Optional - falls back to local customers.json)
# ------------------------------------------------------------------------------
# Example: https://your-project-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=""
FIREBASE_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Gmail SMTP Configuration (Optional - only needed to email sanction letters)
# ------------------------------------------------------------------------------
# Use a 16-character Google App Password (NOT your normal Gmail password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_FROM=""
